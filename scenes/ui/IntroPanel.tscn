theme_override_font_sizes/font_size = 40
text = "HARBIY MUHANDIS"

[node name="Lead" type="Label" parent="Scrim/Center/Card/Rows"]
layout_mode = 2
theme_type_variation = &"Heading"
theme_override_font_sizes/font_size = 19
text = "Siz harbiy lagerga yetib keldingiz. Armiya chekinmoqda, ishlab chiqarish vayron qilingan."
autowrap_mode = 3

[node name="Body" type="Label" parent="Scrim/Center/Card/Rows"]
layout_mode = 2
theme_type_variation = &"Body"
theme_override_font_sizes/font_size = 16
text = "Qo'mondonlik sizni harbiy muhandis etib tayinlaydi. Buyruq qisqa: lagerni ko'zdan kechiring, material yig'ing, mastserskayani tiklang va ishlab chiqarishni yo'lga qo'ying. Birinchi uskuna chiqqach — ko'prikni tuzating, ta'minot kolonnasini o'tkazing, hujumni qaytaring va avanpostni egallang.

Har bajarilgan ish kalendarni oldinga suradi: yillar o'tadi, texnika almashadi, front o'zgaradi. Bir davr yopilganda keyingisi ochiladi."
autowrap_mode = 3

[node name="Thesis" type="Label" parent="Scrim/Center/Card/Rows"]
layout_mode = 2
theme_type_variation = &"MonoLabel"
theme_override_colors/font_color = Color(0.9294, 0.5451, 0.3765, 1)
theme_override_font_sizes/font_size = 14
text = "G'ALABA O'Q SONI BILAN EMAS — MUHANDISLIK YECHIMLARI BILAN QO'LGA KIRITILADI."
autowrap_mode = 3

[node name="Accept" type="Button" parent="Scrim/Center/Card/Rows"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
theme_type_variation = &"BlueprintPrimary"
text = "Vazifani qabul qilaman"
